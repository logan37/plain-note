{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core permissions plus filesystem and dialog access for the user-chosen sync folder.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "android-fs:default",
    "android-fs:allow-write-file",
    "android-fs:allow-remove-file",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-stat",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$APPDATA/**" },
        { "path": "$LOCALDATA/**" },
        { "path": "$RESOURCE/**" },
        { "path": "/storage/**" },
        { "path": "/sdcard/**" },
        { "path": "/mnt/**" },
        { "path": "/data/local/tmp/**" }
      ]
    }
  ]
}
