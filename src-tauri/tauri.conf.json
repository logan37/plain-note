{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plain Note",
  "version": "0.1.0",
  "identifier": "app.plainnote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Plain Note",
        "width": 1120,
        "height": 780,
        "minWidth": 380,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "app", "dmg", "deb", "rpm", "apk"],
    "category": "Productivity",
    "shortDescription": "Encrypted, cloud-synced notes",
    "longDescription": "Lightweight notes with tags, pins and favourites. Notes are encrypted on device and synced as files to a folder you control.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
